    "@fastify/cors": "^11.2.0",
    "@supabase/supabase-js": "^2.89.0",
    "@types/bcryptjs": "^2.4.6",
    "adm-zip": "^0.5.10",
    "bcryptjs": "^3.0.3",
    "chalk": "^5.3.0",
    "cheerio": "^1.2.0",
    "commander": "^12.1.0",
    "fastify": "^5.6.2",
    "fs-extra": "^11.2.0",
    "imap-simple": "^5.1.0",
    "mailparser": "^3.9.1",
    "mongodb": "^7.1.0",
    "openai": "^6.16.0",
    "playwright": "^1.57.0",
    "playwright-core": "^1.57.0",
    "winston": "^3.11.0",
    "zod": "^4.3.5"
