{
  "main": "electron/main.cjs",
  "name": "tauri-appflowdesk",
  "private": true,
  "version": "0.1.2",
  "type": "module",
  "scripts": {
    "dev": "npm run electron:dev",
    "build": "npm run electron:build",
    "preview": "vite preview",
    "electron:dev": "concurrently \"vite\" \"electron .\"",
    "electron:build": "npm run build:backend && npm run build:frontend && electron-builder",
    "build:backend": "cd backend && npm install && npm run build && node install-browsers.cjs",
    "build:backend:win": "cd backend && npm install && npm run build && cross-env BROWSER_PLATFORM=win32 node install-browsers.cjs",
    "build:frontend": "tsc && vite build",
    "postinstall": "electron-builder install-app-deps"
  },
  "build": {
    "appId": "com.flowdesk.app",
    "productName": "FlowDesk",
    "mac": {
      "category": "public.app-category.business"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true
    },
    "directories": {
      "output": "dist_electron"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "backend",
        "to": "backend",
        "filter": [
          "**/*",
          "!src",
          "!tsconfig.json",
          "!*.ts",
          "dist/**/*",
          "node_modules/**/*",
          "browsers/**/*",
          "package.json",
          ".env"
        ]
      }
    ]
  },
  "dependencies": {
    "electron-is-dev": "^3.0.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "wait-on": "^9.0.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.18",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "autoprefixer": "^10.4.23",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "^39.2.7",
    "electron-builder": "^26.4.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.1.18",
    "typescript": "~5.8.3",
    "vite": "^7.0.4"
  }
}